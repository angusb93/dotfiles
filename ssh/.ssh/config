Host nas
  # Reachable over Tailscale (NordVPN kill-switch must be off).
  HostName nas.taile1ace0.ts.net
  User angus

Host nas-lan
  # Direct LAN route (home network only). Use when Tailscale is down or
  # NordVPN's kill-switch is hijacking the tailnet range.
  # NOTE: 192.168.1.96 is a DHCP lease - pin a static reservation for stability.
  HostName 192.168.1.96
  User angus
