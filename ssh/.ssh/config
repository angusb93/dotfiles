# Public SSH config - tracked in the public dotfiles repo.
#
# Host-specific entries live in ~/.ssh/config.d/*.conf and are deliberately NOT
# tracked here: they name real infrastructure (tailnet DNS names, LAN addresses,
# usernames) that should not be published. Only portable, non-identifying
# defaults belong in this file.
#
# Include comes first on purpose. ssh_config is first-obtained-value-wins, so
# any option set above an Include would silently override the host entries it
# pulls in. A glob that matches nothing is not an error.
Include ~/.ssh/config.d/*.conf

Host *
  # IgnoreUnknown lets this file stay portable: UseKeychain is an Apple addition
  # and would be a fatal "Bad configuration option" on stock Linux OpenSSH.
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes

  # Keep long-lived sessions (NAS work, remote editors) from dropping silently.
  ServerAliveInterval 60
  ServerAliveCountMax 3
