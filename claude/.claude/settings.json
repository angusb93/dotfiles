{
  "env": {
    "CLOUD_ML_REGION": "global",
    "ANTHROPIC_VERTEX_PROJECT_ID": "generally-neat-seahorse"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "claude-opus-5[1m]",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "mcp__Sanity__publish_documents",
      "mcp__Sanity__unpublish_documents",
      "mcp__Sanity__discard_drafts",
      "mcp__Sanity__version_discard",
      "mcp__Sanity__deploy_schema",
      "mcp__Sanity__deploy_studio",
      "mcp__Sanity__media_library_publish_documents",
      "mcp__Sanity__media_library_discard_drafts",
      "mcp__Sanity__create_project",
      "mcp__Sanity__create_dataset",
      "mcp__Sanity__update_dataset",
      "mcp__Sanity__add_cors_origin",
      "mcp__Sanity__cors_origins_delete",
      "mcp__Sanity__run_sanity_cli"
    ]
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "voiceEnabled": true,
  "remoteControlAtStartup": true,
  "outputStyle": "concise",
  "tui": "fullscreen",
  "theme": "dark",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_Google_Calendar__.*|mcp__claude_ai_Gmail__.*|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v telegram-agent-approve-hook >/dev/null 2>&1 || exit 0; exec telegram-agent-approve-hook"
          }
        ]
      }
    ]
  },
  "agentPushNotifEnabled": true
}
