#!/usr/bin/env python3
"""Set external monitor brightness from a daily curve of brightness anchors.

The evening is a decay, not a plateau. Comfortable brightness just after dark
is much higher than comfortable brightness a few hours later, so holding one
"evening" level until a hard bedtime cliff is wrong in both directions: too dim
at dusk, too bright by late evening. The curve therefore arrives at EVENING as
the sun sets and then slides down to MIN by WIND_DOWN.

The day is described as a handful of (time, brightness) anchors, and the
brightness at any instant is a linear interpolation between the two anchors
bracketing it:

  WAKE - FADE   MIN        still dark, the rise begins
  WAKE          EVENING    awake before dawn (or MAX if the sun is already up)
  sunrise       MAX        full daylight brightness
  sunset        EVENING    down to a comfortable level as the light goes
  WIND_DOWN     MIN        overnight floor, held until the next rise

Anchors that fall out of order are dropped rather than special-cased, which is
what keeps the curve sane across the seasons: a midsummer sunrise that beats
WAKE drops the pre-dawn anchor so the screen goes straight to MAX with no dip,
and a sunset later than WIND_DOWN drops the dusk anchor so the curve runs
straight to MIN instead of bouncing back up.

Tunables are read from the environment (with sensible defaults) so they can be
adjusted in the launchd agent without editing this file:

  ADAPTIVE_LAT        latitude in degrees        (default 51.5074, London)
  ADAPTIVE_LON        longitude in degrees       (default -0.1278, London)
  ADAPTIVE_MAX        daylight luminance 0-100   (default 100)
  ADAPTIVE_EVENING    luminance at sunset 0-100  (default 35)
  ADAPTIVE_MIN        overnight luminance 0-100  (default 5)
  ADAPTIVE_WAKE       start of the waking day    (default 07:00, local)
  ADAPTIVE_WIND_DOWN  when MIN is reached        (default 21:30, local)
  ADAPTIVE_FADE       morning rise length, mins  (default 60)

Requires `m1ddc` on PATH. Exits quietly if no external display is connected.
"""

import datetime
import math
import os
import shutil
import subprocess
import sys


def _env_float(name: str, default: float) -> float:
    try:
        return float(os.environ[name])
    except (KeyError, ValueError):
        return default


def _env_clock(name: str, default: str) -> datetime.time:
    """Parse an "HH:MM" local wall-clock time from the environment."""
    for candidate in (os.environ.get(name, default), default):
        try:
            hour, minute = (int(part) for part in candidate.split(":", 1))
            return datetime.time(hour, minute)
        except (ValueError, TypeError, AttributeError):
            continue
    return datetime.time(0, 0)


LAT = _env_float("ADAPTIVE_LAT", 51.5074)
LON = _env_float("ADAPTIVE_LON", -0.1278)
MAX_B = _env_float("ADAPTIVE_MAX", 100)
EVENING_B = _env_float("ADAPTIVE_EVENING", 35)
MIN_B = _env_float("ADAPTIVE_MIN", 5)
FADE_MIN = _env_float("ADAPTIVE_FADE", 60)
WAKE = _env_clock("ADAPTIVE_WAKE", "07:00")
WIND_DOWN = _env_clock("ADAPTIVE_WIND_DOWN", "21:30")


def _solar_event(lat: float, lon: float, date: datetime.date, rising: bool):
    """Return the UTC datetime of sunrise/sunset, or None on a polar day/night.

    Implements the standard "Almanac for Computers" algorithm (accurate to ~1
    minute for our purposes).
    """
    zenith = 90.833  # official sunrise/sunset, accounts for refraction + sun radius
    n = date.timetuple().tm_yday
    lng_hour = lon / 15.0
    t = n + (((6 if rising else 18) - lng_hour) / 24)

    # Sun's mean anomaly and true longitude
    m = (0.9856 * t) - 3.289
    lsun = (
        m
        + (1.916 * math.sin(math.radians(m)))
        + (0.020 * math.sin(math.radians(2 * m)))
        + 282.634
    ) % 360

    # Right ascension, kept in the same quadrant as the true longitude
    ra = math.degrees(math.atan(0.91764 * math.tan(math.radians(lsun)))) % 360
    ra += (math.floor(lsun / 90) * 90) - (math.floor(ra / 90) * 90)
    ra /= 15  # into hours

    # Declination
    sin_dec = 0.39782 * math.sin(math.radians(lsun))
    cos_dec = math.cos(math.asin(sin_dec))

    cos_h = (
        math.cos(math.radians(zenith)) - (sin_dec * math.sin(math.radians(lat)))
    ) / (cos_dec * math.cos(math.radians(lat)))
    if cos_h > 1 or cos_h < -1:
        return None  # sun never rises / never sets at this latitude today

    h = (360 - math.degrees(math.acos(cos_h))) if rising else math.degrees(
        math.acos(cos_h)
    )
    h /= 15

    mean_time = h + ra - (0.06571 * t) - 6.622
    ut = (mean_time - lng_hour) % 24
    hour = int(ut)
    minute = int((ut - hour) * 60)
    second = int(((ut - hour) * 60 - minute) * 60)
    return datetime.datetime(
        date.year, date.month, date.day, hour, minute, second,
        tzinfo=datetime.timezone.utc,
    )


def _polar_day(lat: float, date: datetime.date) -> bool:
    """Whether a date with no sunrise/sunset is midnight sun rather than polar night.

    The sun clears the horizon for a whole day when the latitude and the solar
    declination lean the same way and together reach past the pole's 90 degrees.
    """
    n = date.timetuple().tm_yday
    declination = 23.44 * math.sin(math.radians(360 * (n - 81) / 365.0))
    return (lat * declination > 0) and (abs(lat) + abs(declination) > 90)


def _local(date: datetime.date, clock: datetime.time) -> datetime.datetime:
    """Resolve a local wall-clock time on `date` to an absolute instant.

    Going through a naive datetime makes the system time zone apply the DST
    offset in force on that date, so 07:00 stays 07:00 either side of a clock
    change.
    """
    return datetime.datetime.combine(date, clock).astimezone()


def anchors(date: datetime.date):
    """Return the [(instant, brightness)] curve anchors for one local date.

    Anchors are emitted in the order the day runs through them and any that
    would step backwards in time are dropped, so the result is always sorted.
    """
    wake = _local(date, WAKE)
    wind_down = _local(date, WIND_DOWN)
    if wind_down <= wake:
        wind_down = _local(date + datetime.timedelta(days=1), WIND_DOWN)

    fade = datetime.timedelta(minutes=FADE_MIN)
    sunrise = _solar_event(LAT, LON, date, rising=True)
    sunset = _solar_event(LAT, LON, date, rising=False)

    if sunrise is None or sunset is None:
        # Midnight sun spends the whole waking day at MAX; polar night never
        # gets light enough to leave the evening decay.
        if _polar_day(LAT, date):
            return [
                (wake - fade, MIN_B),
                (wake, MAX_B),
                (wind_down - fade, MAX_B),
                (wind_down, MIN_B),
            ]
        return [(wake - fade, MIN_B), (wake, EVENING_B), (wind_down, MIN_B)]

    points = [(wake - fade, MIN_B)]
    if sunrise > wake:
        points.append((wake, EVENING_B))  # awake before dawn
        points.append((sunrise, MAX_B))
    else:
        points.append((wake, MAX_B))  # sun already up by the time we rise

    # Only bend through EVENING when dusk leaves room for a decay longer than
    # the fade; a sunset that lands on top of WIND_DOWN runs straight to MIN
    # instead of dropping off a cliff in the last few minutes.
    dusk = sunset if sunset <= wind_down - fade else None
    hold_until = (dusk or wind_down) - fade
    if hold_until > points[-1][0]:
        points.append((hold_until, MAX_B))
    if dusk is not None and dusk > points[-1][0]:
        points.append((dusk, EVENING_B))

    if wind_down > points[-1][0]:
        points.append((wind_down, MIN_B))
    return points


def target_brightness(now: datetime.datetime) -> float:
    """Interpolate the curve at `now`, holding MIN between successive days."""
    today = now.astimezone().date()
    points = []
    for offset in (-1, 0, 1):
        points.extend(anchors(today + datetime.timedelta(days=offset)))

    if now <= points[0][0]:
        return points[0][1]
    for (t0, b0), (t1, b1) in zip(points, points[1:]):
        if t0 <= now < t1:
            span = (t1 - t0).total_seconds()
            if span <= 0:
                return b1
            return b0 + (b1 - b0) * ((now - t0).total_seconds() / span)
    return points[-1][1]


def _read_luminance(m1ddc: str):
    """Return the monitor's current luminance, or None if unreadable.

    DDC reads are noisy: m1ddc frequently reports 0 (and occasionally a
    negative) for a display that is actually fine, often in a clean
    every-other-read pattern. Because our night floor is well above 0, a
    non-positive reading is never a real luminance here - it is always a glitch
    (or a sleeping/absent display). Sample a few times, discard those, and take
    the median of what's left so a glitch can't make us think brightness is far
    off (which would trigger a redundant write and flash the on-screen
    brightness popup). If every sample is bad, the display isn't readable and we
    report None so the caller leaves it alone.
    """
    samples = []
    for _ in range(5):
        try:
            value = int(
                subprocess.run(
                    [m1ddc, "get", "luminance"],
                    capture_output=True, text=True, timeout=5,
                ).stdout.strip()
            )
        except (ValueError, subprocess.SubprocessError):
            continue  # no external display / DDC unavailable this sample
        if value > 0:
            samples.append(value)
    if not samples:
        return None
    samples.sort()
    return samples[len(samples) // 2]


def main() -> int:
    m1ddc = shutil.which("m1ddc")
    if m1ddc is None:
        print("m1ddc not found on PATH", file=sys.stderr)
        return 1

    now = datetime.datetime.now(datetime.timezone.utc)
    target = round(target_brightness(now))

    # Skip the write if we're already close, to avoid the monitor's on-screen
    # brightness popup flashing on every tick.
    current = _read_luminance(m1ddc)
    if current is None:
        return 0  # nothing to control right now
    if abs(current - target) < 2:
        return 0

    subprocess.run(
        [m1ddc, "set", "luminance", str(target)],
        capture_output=True, text=True, timeout=5,
    )
    print(f"{now.astimezone().strftime('%H:%M')} luminance {current} -> {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
