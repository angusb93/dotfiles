<div class="view view--{{ size }}">
  <div class="layout">
    <div class="d">

      <div class="d-col">
        {% if headlines.size > 0 %}
          <section>
            <div class="lbl"><i class="ic ic-news"></i>Headlines</div>
            <div class="lead">{{ headlines[0].title }}</div>
            <div class="src">{{ headlines[0].source }}</div>
            <div class="heds">
              {% for h in headlines offset:1 limit:4 %}
                <div><div class="hed">{{ h.title }}</div><div class="src">{{ h.source }}</div></div>
              {% endfor %}
            </div>
          </section>
          {% assign max_events = 5 %}
        {% else %}
          {% assign max_events = 10 %}
        {% endif %}

        <section>
          <div class="lbl"><i class="ic ic-calendar"></i>{{ date }}</div>
          {% if events.size == 0 %}
            <div class="none">Nothing in the calendar this week.</div>
          {% endif %}
          {% assign last_day = "" %}
          {% for e in events limit: max_events %}
            {% if e.day != last_day %}
              <div class="day">{{ e.day }}</div>
              {% assign last_day = e.day %}
            {% endif %}
            <div class="ev">
              <span class="t">{{ e.time }}</span>
              <span class="n">{{ e.title }}</span>
              {% if e.where != "" %}<span class="w">{{ e.where }}</span>{% endif %}
            </div>
          {% endfor %}
        </section>
      </div>

      <div class="d-col">
        <section>
          <div class="wx">
            <span class="temp">{{ weather.now }}°</span>
            <div class="side">
              <div class="sum"><i class="ic ic-{{ weather.icon }}"></i>{{ weather.summary }}</div>
              <div class="hl">H {{ weather.high }}°&nbsp; L {{ weather.low }}°</div>
              <div class="rain">
                {% if weather.rain_from != "" %}Rain from {{ weather.rain_from }}{% elsif weather.rain_chance >= 30 %}{{ weather.rain_chance }}% chance of rain{% else %}Dry today{% endif %}<br>Sunset {{ weather.sunset }}
              </div>
            </div>
          </div>
          {% if weather.hours.size > 0 %}
            <div class="hours">
              {% for h in weather.hours %}
                <div><div class="h">{{ h.time }}:00</div><i class="ic ic-{{ h.icon }}"></i><div class="v">{{ h.temp }}°</div><div class="r">{% if h.rain >= 20 %}{{ h.rain }}%{% else %}&nbsp;{% endif %}</div></div>
              {% endfor %}
            </div>
          {% endif %}
        </section>

        <section class="trains">
          <div class="lbl"><i class="ic ic-train"></i>Canonbury</div>
          {% for l in lines %}
            <div class="line">
              <span class="n">{{ l.name }}</span>
              <span class="s{% unless l.good %} bad{% endunless %}">{% if l.good %}Good service{% else %}{{ l.status }}{% endif %}</span>
            </div>
            {% unless l.good %}{% if l.reason != "" %}<div class="reason">{{ l.reason }}</div>{% endif %}{% endunless %}
          {% endfor %}

          <div class="dir">To Shoreditch High Street</div>
          {% if windrush.south.size > 0 %}
            <div class="times">{% for d in windrush.south %}<span>{{ d.time }}</span>{% endfor %}</div>
          {% else %}
            <div class="none">No trains listed</div>
          {% endif %}

          <div class="dir">To Highbury &amp; Islington</div>
          {% if windrush.north.size > 0 %}
            <div class="times">{% for d in windrush.north %}<span>{{ d.time }}</span>{% endfor %}</div>
          {% else %}
            <div class="none">No trains listed</div>
          {% endif %}
        </section>
      </div>

    </div>
  </div>
  <div class="updated">Updated {{ updated }}</div>
</div>
